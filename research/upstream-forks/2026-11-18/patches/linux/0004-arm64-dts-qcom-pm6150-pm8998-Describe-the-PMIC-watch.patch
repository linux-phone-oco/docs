From e123d3bff47d58df77f99246d66fe1af9c3159ef Mon Sep 17 00:00:00 2001
From: orchestration-renewed <agent@creation-guidelines>
Date: Wed, 18 Nov 2026 13:31:38 +0100
Subject: [RFC PATCH 4/4] arm64: dts: qcom: pm6150, pm8998: Describe the PMIC
 watchdog

Add the PMIC watchdog of the PON block, disabled: a board enables it,
and marks it wakeup-source when it wants the watchdog kept running
through suspend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/pm6150.dtsi | 6 ++++++
 arch/arm64/boot/dts/qcom/pm8998.dtsi | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/pm6150.dtsi b/arch/arm64/boot/dts/qcom/pm6150.dtsi
index 59524609f..5d883a76e 100644
--- a/arch/arm64/boot/dts/qcom/pm6150.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm6150.dtsi
@@ -61,6 +61,12 @@ pm6150_resin: resin {
 				bias-pull-up;
 				status = "disabled";
 			};
+
+			pm6150_wdt: watchdog {
+				compatible = "qcom,pm8998-wdt";
+				interrupts = <0x0 0x8 6 IRQ_TYPE_EDGE_RISING>;
+				status = "disabled";
+			};
 		};
 
 		pm6150_vbus: usb-vbus-regulator@1100 {
diff --git a/arch/arm64/boot/dts/qcom/pm8998.dtsi b/arch/arm64/boot/dts/qcom/pm8998.dtsi
index 3ecb33059..8b8730347 100644
--- a/arch/arm64/boot/dts/qcom/pm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm8998.dtsi
@@ -59,6 +59,12 @@ pm8998_resin: resin {
 				bias-pull-up;
 				status = "disabled";
 			};
+
+			pm8998_wdt: watchdog {
+				compatible = "qcom,pm8998-wdt";
+				interrupts = <0x0 0x8 6 IRQ_TYPE_EDGE_RISING>;
+				status = "disabled";
+			};
 		};
 
 		pm8998_temp: temp-alarm@2400 {
-- 
