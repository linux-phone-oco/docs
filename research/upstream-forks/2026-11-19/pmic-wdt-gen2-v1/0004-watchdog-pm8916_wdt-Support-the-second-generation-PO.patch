From cc3933713ed485b03094826fcbbca13e11668651 Mon Sep 17 00:00:00 2001
From: orchestration-renewed <agent@creation-guidelines>
Date: Wed, 18 Nov 2026 13:30:46 +0100
Subject: [PATCH 4/6] watchdog: pm8916_wdt: Support the second generation PON

PM8998 and later PMICs (PM6150, PM8150...) carry the same PMIC watchdog
in their PON_HLOS peripheral: the timers, control and pet registers are
at the same offsets (0x54-0x58), while the power-off reasons moved to
0xc5, with the faults split into registers of their own.

Read the power-off reason from where the PMIC keeps it, through match
data, and only the first reason register on the second generation,
where PMIC_WD is reported.

Written with an AI coding assistant (Claude); reviewed and tested as
described in the cover letter.
---
 drivers/watchdog/pm8916_wdt.c | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/drivers/watchdog/pm8916_wdt.c b/drivers/watchdog/pm8916_wdt.c
index 11b40e0d1..e88c150b5 100644
--- a/drivers/watchdog/pm8916_wdt.c
+++ b/drivers/watchdog/pm8916_wdt.c
@@ -16,6 +16,9 @@
 #define PON_POFF_REASON2_UVLO		BIT(5)
 #define PON_POFF_REASON2_OTST3		BIT(6)
 
+/* Second generation PON (PM8998 and later): the reasons moved, PMIC_WD kept its bit */
+#define PON_GEN2_POFF_REASON1		0xc5
+
 #define PON_INT_RT_STS			0x10
 #define PMIC_WD_BARK_STS_BIT		BIT(6)
 
@@ -38,6 +41,11 @@
 #define PM8916_WDT_MIN_TIMEOUT		1
 #define PM8916_WDT_MAX_TIMEOUT		127
 
+struct pm8916_wdt_data {
+	unsigned int poff_reason;	/* the first power-off reason register */
+	bool poff_reason2;		/* a second follows it: UVLO, OTST3 */
+};
+
 struct pm8916_wdt {
 	struct regmap *regmap;
 	struct watchdog_device wdev;
@@ -194,10 +202,15 @@ static int pm8916_wdt_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct pm8916_wdt *wdt;
+	const struct pm8916_wdt_data *data;
 	struct device *parent;
 	unsigned int val;
 	int err, irq;
-	u8 poff[2];
+	u8 poff[2] = { };
+
+	data = device_get_match_data(dev);
+	if (!data)
+		return -ENODEV;
 
 	wdt = devm_kzalloc_obj(dev, *wdt);
 	if (!wdt)
@@ -238,8 +251,8 @@ static int pm8916_wdt_probe(struct platform_device *pdev)
 		wdt->wdev.info = &pm8916_wdt_ident;
 	}
 
-	err = regmap_bulk_read(wdt->regmap, wdt->baseaddr + PON_POFF_REASON1,
-			       &poff, ARRAY_SIZE(poff));
+	err = regmap_bulk_read(wdt->regmap, wdt->baseaddr + data->poff_reason,
+			       &poff, data->poff_reason2 ? 2 : 1);
 	if (err) {
 		dev_err(dev, "failed to read POFF reason: %d\n", err);
 		return err;
@@ -313,8 +326,18 @@ static int pm8916_wdt_resume(struct device *dev)
 static DEFINE_SIMPLE_DEV_PM_OPS(pm8916_wdt_pm_ops, pm8916_wdt_suspend,
 			 pm8916_wdt_resume);
 
+static const struct pm8916_wdt_data pm8916_wdt_data = {
+	.poff_reason = PON_POFF_REASON1,
+	.poff_reason2 = true,
+};
+
+static const struct pm8916_wdt_data pm8998_wdt_data = {
+	.poff_reason = PON_GEN2_POFF_REASON1,
+};
+
 static const struct of_device_id pm8916_wdt_id_table[] = {
-	{ .compatible = "qcom,pm8916-wdt" },
+	{ .compatible = "qcom,pm8916-wdt", .data = &pm8916_wdt_data },
+	{ .compatible = "qcom,pm8998-wdt", .data = &pm8998_wdt_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, pm8916_wdt_id_table);
