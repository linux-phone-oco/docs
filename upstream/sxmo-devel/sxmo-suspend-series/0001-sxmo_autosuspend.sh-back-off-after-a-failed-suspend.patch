From 2bb2500eea7d7d679ed6f0f49e04c6eed71970bd Mon Sep 17 00:00:00 2001
From: orchestration-renewed <agent@creation-guidelines>
Date: Wed, 18 Nov 2026 13:25:59 +0100
Subject: [PATCH sxmo-utils 1/3] sxmo_autosuspend.sh: back off after a failed
 suspend

A failed sxmo_suspend.sh was retried after one second, every second, for
as long as the kernel kept refusing to suspend. Each aborted suspend still
suspends and resumes devices on the way, so on a phone whose suspend
keeps aborting the USB link was dropped and re-established every few
seconds (26 reconnects in 5 minutes on a POCO X3 NFC), and the CPU never
rested.

Wait 1s after the first failure, then twice as long after each failure in
a row, up to SXMO_SUSPEND_RETRY_MAX seconds (default 64). A suspend that
succeeds starts over at 1s. The new spec drives the loop with mocks and
checks the waits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/sxmo.7.scd                            |  4 +
 scripts/core/sxmo_autosuspend.sh           | 25 ++++++-
 spec/scripts/core/sxmo_autosuspend_spec.sh | 86 ++++++++++++++++++++++
 3 files changed, 111 insertions(+), 4 deletions(-)
 create mode 100644 spec/scripts/core/sxmo_autosuspend_spec.sh

diff --git a/docs/sxmo.7.scd b/docs/sxmo.7.scd
index ae9cfbb..51e5003 100644
--- a/docs/sxmo.7.scd
+++ b/docs/sxmo.7.scd
@@ -1234,6 +1234,10 @@ The default values for environment variables are set in
 	The number of times the audio file will play.
 *SXMO_STATE*
 	the file containing the current state
+*SXMO_SUSPEND_RETRY_MAX*
+	The longest wait, in seconds, before trying again after suspend failed.
+	The wait starts at 1 second and doubles with each failure in a row
+	(default: 64).
 *SXMO_SWAY_SCALE*
 	the scaling factor to use for sway 
 *SXMO_TEXTSOUND*
diff --git a/scripts/core/sxmo_autosuspend.sh b/scripts/core/sxmo_autosuspend.sh
index 4700d8a..036addb 100755
--- a/scripts/core/sxmo_autosuspend.sh
+++ b/scripts/core/sxmo_autosuspend.sh
@@ -8,6 +8,22 @@
 
 set -e
 
+# After a failed suspend, wait before the next try: 1s, then twice as long after
+# each failure in a row, up to SXMO_SUSPEND_RETRY_MAX seconds (default 64). A
+# kernel that keeps refusing to suspend is not asked again every second, and the
+# devices it resumes on every aborted try (a USB link, a modem) are not cycled
+# every second either. A suspend that succeeds starts over at 1s.
+retry_max="${SXMO_SUSPEND_RETRY_MAX:-64}"
+retry_delay=1
+failed_suspend() {
+	sxmo_log "suspend failed, next try in ${retry_delay}s"
+	sleep "$retry_delay"
+	retry_delay="$((retry_delay * 2))"
+	if [ "$retry_delay" -gt "$retry_max" ]; then
+		retry_delay="$retry_max"
+	fi
+}
+
 last_check=0
 wait_can_suspend() {
 	# If we already checked recently, then there's nothing to do. This helps
@@ -35,13 +51,14 @@ while true; do
 		continue
 	fi
 
-	# If sxmo_suspend failed then we didn't enter suspend, it should be safe
-	# to retry immediately. There's a delay so we don't eat up all the
-	# system resoures if the kernel can't suspend.
+	# If sxmo_suspend failed then we didn't enter suspend, it is safe to
+	# retry. The delay grows while it keeps failing, so we don't eat up the
+	# system's resources (or bounce its devices) if the kernel can't suspend.
 	if ! sxmo_suspend.sh; then
-		sleep 1
+		failed_suspend
 		continue
 	fi
+	retry_delay=1
 
 	sleep 10
 done
diff --git a/spec/scripts/core/sxmo_autosuspend_spec.sh b/spec/scripts/core/sxmo_autosuspend_spec.sh
new file mode 100644
index 0000000..f99b05f
--- /dev/null
+++ b/spec/scripts/core/sxmo_autosuspend_spec.sh
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright (c) 2026 Sxmo Contributors
+
+# Shellspec formatting confuses shellcheck, so we have to disbale some checks
+# SC2317: Command appears to be unreachable
+# SC2329: Command not invoked
+# SC2034: variable appears unused
+# shellcheck disable=SC2317 disable=SC2329 disable=SC2034
+
+# appended, so the mocks below come first (sxmo_suspend.sh is in scripts/core)
+PATH="$PATH:$(pwd)/scripts/core"
+
+# The loop never ends by itself: the sleep mock records each wait and fails
+# after $SPEC_WAITS of them, which ends the script (it runs with set -e).
+
+Describe "sxmo_autosuspend.sh"
+	setup() {
+		SPEC_TMP="$(mktemp -d)"
+		XDG_STATE_HOME="$SPEC_TMP"
+		export SPEC_TMP XDG_STATE_HOME
+		unset SXMO_SUSPEND_RETRY_MAX
+	}
+	cleanup() {
+		rm -rf "$SPEC_TMP"
+	}
+	BeforeEach setup
+	AfterEach cleanup
+
+	Mock cat
+		if [ "$1" = /sys/power/wakeup_count ]; then
+			echo 7
+		else
+			/bin/cat "$@"
+		fi
+	End
+
+	Mock doas
+		/bin/cat > /dev/null
+	End
+
+	Mock sxmo_hook_block_suspend.sh
+		true
+	End
+
+	# Each call takes the next word of $SPEC_OUTCOMES (ok or fail), then fails
+	Mock sxmo_suspend.sh
+		echo x >> "$SPEC_TMP/suspends"
+		n="$(wc -l < "$SPEC_TMP/suspends")"
+		outcome="$(echo "$SPEC_OUTCOMES" | cut -d' ' -f"$n")"
+		[ "$outcome" = ok ]
+	End
+
+	Mock sleep
+		echo "$1" >> "$SPEC_TMP/waits"
+		[ "$(wc -l < "$SPEC_TMP/waits")" -lt "$SPEC_WAITS" ]
+	End
+
+	waits() {
+		tr '\n' ' ' < "$SPEC_TMP/waits"
+	}
+
+	It "waits twice as long after each failed suspend, up to 64s"
+		export SPEC_OUTCOMES="" SPEC_WAITS=9
+		When run script scripts/core/sxmo_autosuspend.sh
+		The status should be failure
+		The stderr should include "suspend failed, next try in 1s"
+		The stderr should include "suspend failed, next try in 64s"
+		The result of function waits should equal "1 2 4 8 16 32 64 64 64 "
+	End
+
+	It "caps the wait at SXMO_SUSPEND_RETRY_MAX"
+		export SPEC_OUTCOMES="" SPEC_WAITS=5 SXMO_SUSPEND_RETRY_MAX=5
+		When run script scripts/core/sxmo_autosuspend.sh
+		The status should be failure
+		The stderr should include "next try in 5s"
+		The result of function waits should equal "1 2 4 5 5 "
+	End
+
+	It "starts over at 1s after a suspend that succeeds"
+		export SPEC_OUTCOMES="fail fail ok fail" SPEC_WAITS=4
+		When run script scripts/core/sxmo_autosuspend.sh
+		The status should be failure
+		The stderr should include "next try in 2s"
+		The result of function waits should equal "1 2 10 1 "
+	End
+End
