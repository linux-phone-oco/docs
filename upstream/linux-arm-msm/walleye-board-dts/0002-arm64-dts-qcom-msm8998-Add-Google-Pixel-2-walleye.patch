From e674cd956fb38e717367c3e250b010de359b8fa9 Mon Sep 17 00:00:00 2001
From: "walleye-builder.e7150c" <idunerg+walleye-builder.e7150c@gmail.com>
Date: Thu, 19 Nov 2026 07:52:22 +0100
Subject: [PATCH 2/2] arm64: dts: qcom: msm8998: Add Google Pixel 2 (walleye)

Add a minimal device tree for the Google Pixel 2: the reserved memory,
the RPM regulators the USB 2.0 PHY stands on, the USB controller as a
high-speed peripheral, ramoops and the debug UART.

Storage, display, touch, GPU, Wi-Fi and the remote processors are not
described yet.
---
 arch/arm64/boot/dts/qcom/Makefile             |   1 +
 .../boot/dts/qcom/msm8998-google-walleye.dts  | 196 ++++++++++++++++++
 2 files changed, 197 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/msm8998-google-walleye.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 1c86e7e98..46bfe110e 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -151,6 +151,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-xiaomi-natrium.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-xiaomi-scorpio.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-asus-novago-tp370ql.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-fxtec-pro1.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-google-walleye.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-hp-envy-x2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-lenovo-miix-630.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-mtp.dtb
diff --git a/arch/arm64/boot/dts/qcom/msm8998-google-walleye.dts b/arch/arm64/boot/dts/qcom/msm8998-google-walleye.dts
new file mode 100644
index 000000000..d24ca5384
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8998-google-walleye.dts
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google Pixel 2 (walleye) device tree
+ *
+ * Storage (UFS), display, touch, GPU, Wi-Fi and the remote processors are
+ * not described yet.
+ *
+ * Based on the wahoo board files:
+ * Copyright (c) 2020 Caleb Connolly <caleb@connolly.tech>
+ * and on the OnePlus 5(T) common file:
+ * Copyright (c) 2021, Jami Kettunen <jamipkettunen@gmail.com>
+ * Copyright (c) 2016, The Linux Foundation. All rights reserved.
+ */
+
+/dts-v1/;
+
+#include "msm8998.dtsi"
+#include "pm8998.dtsi"
+#include "pmi8998.dtsi"
+
+/delete-node/ &mpss_mem;
+/delete-node/ &venus_mem;
+/delete-node/ &mba_mem;
+/delete-node/ &slpi_mem;
+
+/ {
+	compatible = "google,walleye", "qcom,msm8998";
+	chassis-type = "handset";
+	model = "Google Pixel 2";
+
+	/* Required for the bootloader to select this board (v2.1) */
+	qcom,msm-id = <292 0x20001>;
+
+	aliases {
+		serial0 = &blsp2_uart1;
+	};
+
+	reserved-memory {
+		/* Carve-outs for the modem, video, MBA and sensor hub images */
+		mpss_mem: memory@8cc00000 {
+			reg = <0x0 0x8cc00000 0x0 0x7800000>;
+			no-map;
+		};
+
+		venus_mem: memory@94400000 {
+			reg = <0x0 0x94400000 0x0 0x500000>;
+			no-map;
+		};
+
+		mba_mem: memory@94900000 {
+			reg = <0x0 0x94900000 0x0 0x200000>;
+			no-map;
+		};
+
+		slpi_mem: memory@94b00000 {
+			reg = <0x0 0x94b00000 0x0 0x700000>;
+			no-map;
+		};
+
+		/* Matches the ramoops region of the stock Pixel 2 firmware */
+		ramoops@a1100000 {
+			compatible = "ramoops";
+			reg = <0x0 0xa1100000 0x0 0x200000>;
+			console-size = <0x20000>;
+			record-size = <0x80000>;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-name = "vph_pwr";
+	};
+};
+
+/*
+ * The GPU IOMMU is powered by the GPU GX power domain, which must not be
+ * switched on until the GPU rail is described. Keep it off until then.
+ */
+&adreno_smmu {
+	status = "disabled";
+};
+
+/* The debug UART of the Pixel debug cable */
+&blsp2_uart1 {
+	status = "okay";
+};
+
+&qusb2phy {
+	vdd-supply = <&vreg_l1a_0p875>;
+	vdda-phy-dpdm-supply = <&vreg_l24a_3p075>;
+	vdda-pll-supply = <&vreg_l12a_1p8>;
+
+	status = "okay";
+};
+
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm8998-regulators";
+
+		vdd_l1_l27-supply = <&vreg_s7a_1p025>;
+		vdd_l2_l8_l17-supply = <&vreg_s3a_1p35>;
+		vdd_l7_l12_l14_l15-supply = <&vreg_s5a_2p04>;
+		vdd_l20_l24-supply = <&vreg_bob>;
+		vdd_lvs1_lvs2-supply = <&vreg_s4a_1p8>;
+		vdd_s3-supply = <&vph_pwr>;
+		vdd_s4-supply = <&vph_pwr>;
+		vdd_s5-supply = <&vph_pwr>;
+		vdd_s7-supply = <&vph_pwr>;
+
+		vreg_l1a_0p875: l1 {
+			regulator-max-microvolt = <880000>;
+			regulator-min-microvolt = <880000>;
+		};
+
+		/* Named in msm8998.dtsi: DSI PHY, UFS PHY PLL */
+		vreg_l2a_1p2: l2 {
+			regulator-max-microvolt = <1200000>;
+			regulator-min-microvolt = <1200000>;
+		};
+
+		vreg_l12a_1p8: l12 {
+			regulator-max-microvolt = <1800000>;
+			regulator-min-microvolt = <1800000>;
+		};
+
+		vreg_l24a_3p075: l24 {
+			regulator-max-microvolt = <3088000>;
+			regulator-min-microvolt = <3088000>;
+		};
+
+		/* Named in msm8998.dtsi: sensor hub */
+		vreg_lvs2a_1p8: lvs2 {
+			regulator-max-microvolt = <1800000>;
+			regulator-min-microvolt = <1800000>;
+		};
+
+		vreg_s3a_1p35: s3 {
+			regulator-max-microvolt = <1352000>;
+			regulator-min-microvolt = <1352000>;
+		};
+
+		vreg_s4a_1p8: s4 {
+			regulator-allow-set-load;
+			regulator-max-microvolt = <1800000>;
+			regulator-min-microvolt = <1800000>;
+		};
+
+		vreg_s5a_2p04: s5 {
+			regulator-max-microvolt = <2040000>;
+			regulator-min-microvolt = <1904000>;
+		};
+
+		vreg_s7a_1p025: s7 {
+			regulator-max-microvolt = <1028000>;
+			regulator-min-microvolt = <900000>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,rpm-pmi8998-regulators";
+
+		vdd_bob-supply = <&vph_pwr>;
+
+		vreg_bob: bob {
+			regulator-max-microvolt = <3600000>;
+			regulator-min-microvolt = <3312000>;
+		};
+	};
+};
+
+&tlmm {
+	/* Pins owned by the secure world */
+	gpio-reserved-ranges = <0 4>, <81 4>;
+};
+
+&usb3 {
+	/* Operate GCC_USB30_MASTER_CLK in HS mode (>= 60 MHz) */
+	assigned-clock-rates = <19200000>, <60000000>;
+
+	/* Disable the USB3 pipe_clk requirement */
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+&usb3_dwc3 {
+	/* Peripheral until the type-C port is hooked up */
+	dr_mode = "peripheral";
+
+	/* The SuperSpeed PHY is not described: high speed only */
+	maximum-speed = "high-speed";
+	phys = <&qusb2phy>;
+	phy-names = "usb2-phy";
+};
-- 
